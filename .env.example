# Variables d'environnement — Gestion Immobilière de l'Estrie
# Copiez ce fichier en .env.local et renseignez les valeurs.
# NE JAMAIS committer .env.local dans le dépôt.

# ─────────────────────────────────────────────
# SANITY CMS
# ─────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# ─────────────────────────────────────────────
# ASSISTANT IA (intégration future)
# Clé lue exclusivement côté serveur (app/api/assistant/route.ts)
# Ne jamais préfixer par NEXT_PUBLIC_
# ─────────────────────────────────────────────
AI_API_KEY=

# ─────────────────────────────────────────────
# FORMULAIRE DE CONTACT (si applicable)
# ─────────────────────────────────────────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# CONTACT_TO_EMAIL=info@immoestrie.ca
